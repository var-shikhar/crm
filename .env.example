# Copy to .env and replace every value, or run ./scripts/init-env.sh to generate one.

# Published ports
GATEWAY_PORT=8080
MAILPIT_PORT=8025

# Public URL of the auth service as seen through the gateway (the token issuer)
ISSUER=http://localhost:8080/auth

# Postgres
POSTGRES_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
CUSTOMER_DB_PASSWORD=change-me
AUDIT_DB_PASSWORD=change-me

# Auth service
SECRET_KEY=change-me                      # encrypts TOTP secrets at rest
CUSTOMER_SERVICE_CLIENT_SECRET=change-me  # OAuth client secret of customer-service
AUDIT_SERVICE_CLIENT_SECRET=change-me     # OAuth client secret of audit-service

# First administrator (created on first start only)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-10-chars

# Email for one-time codes. Defaults deliver to the bundled Mailpit inbox.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=CRM Security <no-reply@crm.example.com>
