{
  "openapi": "3.1.0",
  "info": {
    "title": "CRM Audit Service",
    "summary": "Append-only activity log: who did what, to what, when, and from where.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/events/batch": {
      "post": {
        "tags": [
          "Ingest (service-to-service)"
        ],
        "summary": "Deliver activity events",
        "description": "Idempotent: an `event_id` that was already stored is counted as a duplicate and skipped,\nso senders can safely retry.",
        "operationId": "ingest_api_v1_events_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/events": {
