          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact action, or a prefix ending in `*` (e.g. `customer.*`)",
              "title": "Action"
            },
            "description": "Exact action, or a prefix ending in `*` (e.g. `customer.*`)"
