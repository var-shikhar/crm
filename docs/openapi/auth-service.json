    "/api/v1/authz/check": {
      "post": {
        "tags": [
          "Authorization (service-to-service)"
        ],
        "summary": "Authenticate a token and authorize one action",
        "description": "The single decision point every other service calls before acting.\n\nCaller authenticates with HTTP Basic (its client id and secret).\n`active=false` means the token is not valid (expired, revoked, user disabled);\n`allowed=false` means the token is valid but its owner lacks `permission`.\nDenials are recorded in the activity log.",
        "operationId": "check_api_v1_authz_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthzCheckIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthzCheckOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
