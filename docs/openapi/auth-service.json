{
  "openapi": "3.1.0",
  "info": {
    "title": "CRM Auth Service",
    "summary": "Central identity, OAuth 2.0 token service, MFA and role-based access control.",
    "description": "Issues and validates tokens, manages users, roles and permissions, and makes every authorization decision for the other CRM services via `POST /api/v1/authz/check`.",
    "version": "1.0.0"
  },
  "paths": {
    "/oauth/token": {
      "post": {
        "tags": [
          "OAuth 2.0"
        ],
        "summary": "Token endpoint",
        "operationId": "token_oauth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_token_oauth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "OAuth error (`invalid_grant`, `invalid_request`, `unsupported_grant_type`, ...)"
          },
          "401": {
            "description": "`invalid_client`"
          },
          "403": {
            "description": "`mfa_required` (password grant, account has a second factor): body carries `mfa_token` and `mfa_method`; retry with the MFA grant and the one-time code"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/revoke": {
      "post": {
        "tags": [
          "OAuth 2.0"
        ],
        "summary": "Revoke a token (RFC 7009) - sign out",
        "description": "Revoking a refresh token ends that whole login session. Always answers 200.",
        "operationId": "revoke_oauth_revoke_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
